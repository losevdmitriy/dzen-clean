{
  "name": "@adguard/tsurlfilter",
  "description": "This is a TypeScript library that implements AdGuard's content blocking rules",
  "main": "dist/es/index.js",
  "module": "dist/es/index.js",
  "iife": "dist/tsurlfilter.iife.js",
  "types": "dist/types/src/index.d.ts",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/types/src/index.d.ts",
      "import": "./dist/es/index.js",
      "require": "./dist/tsurlfilter.umd.js"
    },
    "./es/request-type": {
      "import": "./dist/es/request-type.js",
      "types": "./dist/types/src/request-type.d.ts"
    },
    "./es/network-rule-options": {
      "import": "./dist/es/network-rule-options.js",
      "types": "./dist/types/src/rules/network-rule-options.d.ts"
    },
    "./es/simple-regex": {
      "import": "./dist/es/simple-regex.js",
      "types": "./dist/types/src/rules/simple-regex.d.ts"
    },
    "./es/*": "./dist/es/*.js",
    "./umd": "./dist/tsurlfilter.umd.js"
  },
  "typesVersions": {
    "*": {
      "*": [
        "dist/types/src/index.d.ts"
      ],
      "es/request-type": [
        "dist/types/src/request-type.d.ts"
      ],
      "es/cosmetic-rule-marker": [
        "dist/types/src/rules/cosmetic-rule-marker.d.ts"
      ],
      "es/network-rule-options": [
        "dist/types/src/rules/network-rule-options.d.ts"
      ],
      "es/simple-regex": [
        "dist/types/src/rules/simple-regex.d.ts"
      ]
    }
  },
  "author": "Adguard Software Ltd.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AdGuardSoftwareLimited/ext-tsurlfilter.git",
    "directory": "packages/tsurlfilter"
  },
  "license": "GPL-3.0-only",
  "engines": {
    "node": ">=22"
  },
  "bugs": {
    "url": "https://github.com/AdguardTeam/tsurlfilter/issues"
  },
  "homepage": "https://github.com/AdguardTeam/tsurlfilter/tree/master/packages/tsurlfilter#readme",
  "lint-staged": {
    "{src,test}/**/*.ts": [
      "eslint"
    ]
  },
  "dependencies": {
    "@adguard/scriptlets": "2.5.1",
    "cidr-tools": "^6.4.1",
    "is-cidr": "4.0.2",
    "is-ip": "3.1.0",
    "lru-cache": "^11.0.2",
    "punycode": "2.3.1",
    "tldts": "^5.7.112",
    "zod": "3.24.4",
    "zod-validation-error": "^3.4.0",
    "@adguard/logger": "^2.0.1",
    "@adguard/agtree": "^4.3.0",
    "@adguard/css-tokenizer": "^1.2.0"
  },
  "devDependencies": {
    "tsurlfilter-v3": "npm:@adguard/tsurlfilter@^3.3.3",
    "@adguard/eslint-plugin-logger-context": "^1.0.1",
    "@rollup/plugin-alias": "^5.1.1",
    "@rollup/plugin-commonjs": "^28.0.1",
    "@rollup/plugin-json": "^6.1.0",
    "@rollup/plugin-node-resolve": "^15.3.0",
    "@rollup/plugin-terser": "^0.4.4",
    "@rollup/plugin-typescript": "^12.1.1",
    "@swc/core": "^1.10.18",
    "@swc/jest": "0.2.36",
    "@types/chrome": "^0.0.305",
    "@types/ip6addr": "0.2.3",
    "@types/lodash": "^4.17.0",
    "@types/lodash-es": "^4.17.12",
    "@types/netmask": "1.0.30",
    "@types/node": "^22.14.0",
    "@types/punycode": "2.1.4",
    "@types/rollup-plugin-node-globals": "1.4.1",
    "@typescript-eslint/eslint-plugin": "^7.5.0",
    "@typescript-eslint/parser": "^7.5.0",
    "@vitest/coverage-v8": "^5.0.0",
    "@vitest/expect": "^5.0.0",
    "coveralls": "3.1.1",
    "cross-env": "^7.0.3",
    "esbuild": "^0.19.12",
    "esbuild-register": "^3.5.0",
    "escape-string-regexp": "^5.0.0",
    "eslint": "8.57.1",
    "eslint-config-airbnb-base": "15.0.0",
    "eslint-config-airbnb-typescript": "^18.0.0",
    "eslint-plugin-boundaries": "^5.0.1",
    "eslint-plugin-import": "^2.29.0",
    "eslint-plugin-import-newlines": "1.4.0",
    "eslint-plugin-jsdoc": "^48.11.0",
    "eslint-plugin-n": "^17.21.3",
    "lint-staged": "^13.2.2",
    "lodash-es": "^4.17.21",
    "markdownlint": "^0.37.4",
    "markdownlint-cli": "^0.44.0",
    "msw": "^2.7.0",
    "rimraf": "^6.0.1",
    "rollup": "^4.28.0",
    "rollup-plugin-cleanup": "^3.2.1",
    "rollup-plugin-node-externals": "^8.0.0",
    "rollup-plugin-polyfill-node": "^0.13.0",
    "tldts-core": "^6.1.13",
    "ts-morph": "^26.0.0",
    "tsd": "^0.32.0",
    "tslib": "^2.8.1",
    "tsx": "^4.19.3",
    "typedoc": "0.28.4",
    "typescript": "^5.7.3",
    "vitest": "^5.0.0"
  },
  "version": "6.0.4",
  "scripts": {
    "lint": "pnpm lint:code && pnpm lint:types && pnpm lint:md",
    "lint:code": "eslint --cache --ignore-path .gitignore .",
    "lint:types": "tsc",
    "lint:md": "markdownlint .",
    "start": "rollup -c rollup.config.ts -w",
    "prebuild": "rimraf dist && pnpm build:types",
    "build": "pnpm prebuild && rollup -c rollup.config.ts --configPlugin typescript --bundleConfigAsCjs",
    "build:types": "tsc --project tsconfig.build.json --declaration --emitDeclarationOnly --outdir dist/types && tsx tasks/transform-dts.ts",
    "docs": "typedoc src --out docs",
    "test": "vitest run",
    "bench": "vitest bench --run --reporter=default --reporter=json --outputFile.json=.vitest/bench/tsurlfilter.json",
    "test:ci": "vitest run --no-cache --reporter default --reporter junit --outputFile=./tests-reports/tsurlfilter.xml",
    "test:light": "vitest run --exclude \"**/test/engine/start-engine.test.ts\"",
    "test:watch": "vitest run --watch",
    "test:coverage": "vitest run --coverage",
    "test:smoke": "cd test/builders/rollup-ts && pnpm test",
    "test:prod": "pnpm lint && pnpm test:smoke && pnpm test:ci",
    "test:debug": "vitest run --inspect --no-file-parallelism --watch",
    "report-coverage": "cat ./coverage/lcov.info | coveralls",
    "precommit": "lint-staged",
    "tgz": "pnpm pack --out tsurlfilter.tgz"
  }
}